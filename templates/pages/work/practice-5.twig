						<h3>Задание 8. Создать backup-скрипт</h3>

<pre class="language-bash code-small"><code>nano /opt/saas/scripts/backup-saas.sh</code></pre>

						<p>
							Содержимое файла:
						</p>

<pre class="language-bash code-small"><code>#!/bin/bash

set -e

BACKUP_ROOT="/opt/saas/backups"
REDIS_BACKUP_DIR="$BACKUP_ROOT/redis"
LOG_FILE="/opt/saas/logs/backup.log"
DATE=$(date +%Y-%m-%d_%H-%M-%S)
ARCHIVE_PATH="$BACKUP_ROOT/saas-backup-$DATE.tar.gz"

APP_DIR="/var/www/saas-app"
NGINX_CONF="/etc/nginx/sites-available/saas-app"
APACHE_CONF="/etc/apache2/sites-available/saas-app.conf"
NGINX_SSL="/etc/nginx/ssl"
SAAS_DATA="/opt/saas/data"

mkdir -p "$BACKUP_ROOT"
mkdir -p "$REDIS_BACKUP_DIR"
mkdir -p "$(dirname "$LOG_FILE")"

echo "[$(date)] Backup started" &gt;&gt; "$LOG_FILE"

REDIS_RDB_COPY=""

if systemctl is-active --quiet redis-server; then
    REDIS_DIR=$(redis-cli CONFIG GET dir | tail -n 1)
    REDIS_DBFILENAME=$(redis-cli CONFIG GET dbfilename | tail -n 1)

    REDIS_RDB_SOURCE="$REDIS_DIR/$REDIS_DBFILENAME"
    REDIS_RDB_COPY="$REDIS_BACKUP_DIR/$REDIS_DBFILENAME"

    echo "[$(date)] Redis dir: $REDIS_DIR" &gt;&gt; "$LOG_FILE"
    echo "[$(date)] Redis dbfilename: $REDIS_DBFILENAME" &gt;&gt; "$LOG_FILE"
    echo "[$(date)] Creating Redis snapshot" &gt;&gt; "$LOG_FILE"

    BEFORE_SAVE=$(redis-cli LASTSAVE)

    redis-cli BGSAVE &gt;&gt; "$LOG_FILE" 2&gt;&amp;1 || true

    for i in {1..30}; do
        AFTER_SAVE=$(redis-cli LASTSAVE)

        if [ "$AFTER_SAVE" != "$BEFORE_SAVE" ]; then
            echo "[$(date)] Redis snapshot completed" &gt;&gt; "$LOG_FILE"
            break
        fi

        sleep 1
    done

    if [ -f "$REDIS_RDB_SOURCE" ]; then
        sudo cp "$REDIS_RDB_SOURCE" "$REDIS_RDB_COPY"
        sudo chown "$(whoami)":"$(whoami)" "$REDIS_RDB_COPY"
        echo "[$(date)] Redis dump copied from $REDIS_RDB_SOURCE" \
		&gt;&gt; "$LOG_FILE"
    else
        echo "[$(date)] WARNING: Redis dump not found: $REDIS_RDB_SOURCE" \
		&gt;&gt; "$LOG_FILE"
        REDIS_RDB_COPY=""
    fi
else
    echo "[$(date)] WARNING: redis-server is not active" &gt;&gt; "$LOG_FILE"
fi

echo "[$(date)] Creating archive: $ARCHIVE_PATH" &gt;&gt; "$LOG_FILE"

if [ -n "$REDIS_RDB_COPY" ] &amp;&amp; [ -f "$REDIS_RDB_COPY" ]; then
    tar -czf "$ARCHIVE_PATH" \
        "$APP_DIR" \
        "$NGINX_CONF" \
        "$APACHE_CONF" \
        "$NGINX_SSL" \
        "$SAAS_DATA" \
        "$REDIS_RDB_COPY"
else
    tar -czf "$ARCHIVE_PATH" \
        "$APP_DIR" \
        "$NGINX_CONF" \
        "$APACHE_CONF" \
        "$NGINX_SSL" \
        "$SAAS_DATA"
fi

find "$BACKUP_ROOT" -maxdepth 1 -name "saas-backup-*.tar.gz" -type f \
-mtime +7 -delete

echo "[$(date)] Backup created: $ARCHIVE_PATH" &gt;&gt; "$LOG_FILE"
echo "[$(date)] Old backups rotation completed" &gt;&gt; "$LOG_FILE"
echo "[$(date)] Backup finished successfully" &gt;&gt; "$LOG_FILE"

echo "Backup created: $ARCHIVE_PATH"</code></pre>

