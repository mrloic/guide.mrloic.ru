{% extends 'layouts/base.twig' %}

{% set page_title = 'Практическая работа №1' %}
{% set body_class = 'subpage' %}

{% block head %}
	<link rel="stylesheet" href="/assets/css/works/pr1.css" />
	<style>
		.screenshot-place {
			display: flex;
			flex-direction: column;
			flex-wrap: nowrap;
			justify-content: center;
			align-items: center;
		}

		.screenshot-place img {
			width: 800px;
		}

		.slider {
			position: relative;
			width: 600px;
			max-width: 100%;
			margin: 0 auto;
			overflow: hidden;
		}

		.slides {
			position: relative;
		}

		.slide {
			display: none;
			width: 100%;
			height: 350px;
			object-fit: cover;
			border-radius: 12px;
		}

		.slide.active {
			display: block;
		}

		.prev, .next {
			position: absolute;
			top: 50%;
			transform: translateY(-59%);
			background: rgba(0, 0, 0, 0.5);
			color: white;
			border: none;
			font-size: 32px;
			padding: 5px 18px;
			cursor: pointer;
			border-radius: 50%;
			z-index: 2;
		}

		.prev {
			left: 0px;
		}

		.next {
			right: 0px;
		}
	</style>
{% endblock %}

