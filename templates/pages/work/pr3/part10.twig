		<tr>
			<th>Параметр</th>
			<th>Значение</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>Hostname</td>
			<td></td>
		</tr>
		<tr>
			<td>IP-адрес сервера</td>
			<td></td>
		</tr>
		<tr>
			<td>Версия Nginx</td>
			<td></td>
		</tr>
		<tr>
			<td>HTTP-порт открыт</td>
			<td>да / нет</td>
		</tr>
		<tr>
			<td>HTTPS-порт открыт</td>
			<td>да / нет</td>
		</tr>
		<tr>
			<td>Backend-порт</td>
			<td></td>
		</tr>
		<tr>
			<td>Конфигурация сайта</td>
			<td></td>
		</tr>
