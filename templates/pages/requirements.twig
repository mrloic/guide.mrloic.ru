{% extends 'layouts/base.twig' %}

{% set page_title = 'Требования' %}
{% set body_class = 'subpage' %}
{% block head %}
	<style>


		code, kbd { font-family: "Roboto Mono", "Courier New", Courier, monospace; background-color: #f5f5f5; }

		pre { box-sizing: border-box; width: 100%; max-width: 100%; margin: 1em 0; padding: 16px 18px;

		background-color: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 6px;

		overflow-x: hidden;

		white-space: pre-wrap; }

		pre code { display: block; padding: 0; margin: 0;

		background: transparent; color: #222;

		font-family: "Roboto Mono", "Courier New", Courier, monospace; font-size: 14px; line-height: 1.6;

		white-space: pre-wrap; overflow-wrap: break-word; word-break: normal; }

		table { background: white; border: 1px solid #666; border-collapse: collapse; padding: 0.5em; }

		table thead th, table tfoot th { text-align: left; background-color: #eaeaea; color: black; }

		table th, table td { border: 1px solid #ddd; padding: 0.5em; }

		table td { color: #222222; }

		.callout[data-callout="abstract"] .callout-title, .callout[data-callout="summary"] .callout-title,
		.callout[data-callout="tldr"] .callout-title, .callout[data-callout="faq"] .callout-title,
		.callout[data-callout="info"] .callout-title, .callout[data-callout="help"] .callout-title { background-color:
		#828ee7; } .callout[data-callout="tip"] .callout-title, .callout[data-callout="hint"] .callout-title,
		.callout[data-callout="important"] .callout-title { background-color: #34bbe6; }
		.callout[data-callout="success"] .callout-title, .callout[data-callout="check"] .callout-title,
		.callout[data-callout="done"] .callout-title { background-color: #a3e048; } .callout[data-callout="question"]
		.callout-title, .callout[data-callout="todo"] .callout-title { background-color: #49da9a; }
		.callout[data-callout="caution"] .callout-title, .callout[data-callout="attention"] .callout-title {
		background-color: #f7d038; } .callout[data-callout="warning"] .callout-title, .callout[data-callout="missing"]
		.callout-title, .callout[data-callout="bug"] .callout-title { background-color: #eb7532; }
		.callout[data-callout="failure"] .callout-title, .callout[data-callout="fail"] .callout-title,
		.callout[data-callout="danger"] .callout-title, .callout[data-callout="error"] .callout-title {
		background-color: #e6261f; } .callout[data-callout="example"] .callout-title { background-color: #d23be7; }
		.callout[data-callout="quote"] .callout-title, .callout[data-callout="cite"] .callout-title { background-color:
		#aaaaaa; }

		.callout-icon { flex: 0 0 auto; display: flex; align-self: center; }

		svg.svg-icon { height: 18px; width: 18px; stroke-width: 1.75px; }

		.callout { overflow: hidden; margin: 1em 0; box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 1px 5px 0 rgba(0, 0,
		0, 0.12), 0 3px 1px -2px rgba(0, 0, 0, 0.2); border-radius: 4px; }

		.callout-title { padding: 0.5em; display: flex; gap: 8px; font-size: inherit; color: black; line-height: 1.3em;
		}

		.callout-title-inner { font-weight: bold; color: black; }

		.callout-content { overflow-x: auto; padding: 0.25em 0.5em; color: #222222; background-color: white !important;
		}

		ul.contains-task-list { padding-left: 0; list-style: none; }

		ul.contains-task-list ul.contains-task-list { padding-left: 2em; }

		ul.contains-task-list li input[type="checkbox"] { margin-right: 0.5em; }

		.callout-table, .callout-table tr, .callout-table p { width: 100%; padding: 0; }

		.callout-table td { width: 100%; padding: 0 1em; }

		.callout-table p { padding-bottom: 0.5em; }

		.source-table { width: 100%; background-color: #f5f5f5; }
	</style>
{% endblock %}
{% block content %}
	<section id="content">
		<div class="container">
			<div class="row">
				<!-- Основная колонка -->
				<div class="col-9 col-12-medium">
					<section>
						<header>
							<h2>2. Требования</h2>
						</header>
						<p dir="auto">
							Раздел содержит перечень требований к виртуальной машине, операционной системе, сетевой
							конфигурации, программным компонентам и сервисам, необходимым для развёртывания учебной
							SaaS-инфраструктуры.
						</p>
						<h3 data-heading="2.1 Требования к виртуальной машине" dir="auto">
							2.1 Требования к виртуальной машине
						</h3>
						<table>
							<thead>
								<tr>
									<th>Компонент</th>
									<th align="right">Минимальное значение</th>
									<th align="right">Рекомендуемое значение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Тип среды</td>
									<td align="right">виртуальная машина</td>
									<td align="right">
										виртуальная машина в Proxmox VE / VirtualBox / VMware / Hyper-V
									</td>
								</tr>
								<tr>
									<td>Архитектура</td>
									<td align="right">amd64 / x86_64</td>
									<td align="right">amd64 / x86_64</td>
								</tr>
								<tr>
									<td>CPU</td>
									<td align="right">2 vCPU</td>
									<td align="right">4 vCPU</td>
								</tr>
								<tr>
									<td>RAM</td>
									<td align="right">2 GB</td>
									<td align="right">4–8 GB</td>
								</tr>
								<tr>
									<td>Диск</td>
									<td align="right">20 GB</td>
									<td align="right">40 GB SSD/NVMe</td>
								</tr>
								<tr>
									<td>Сетевой адаптер</td>
									<td align="right">1 адаптер</td>
									<td align="right">bridge/NAT с доступом в Интернет</td>
								</tr>
								<tr>
									<td>Доступ к серверу</td>
									<td align="right">консоль ВМ</td>
									<td align="right">SSH + консоль ВМ</td>
								</tr>
							</tbody>
						</table>
						<h3 data-heading="2.2 Требования к операционной системе" dir="auto">
							2.2 Требования к операционной системе
						</h3>
						<p dir="auto">
							В лабораторных работах допускается использовать один из следующих дистрибутивов:
						</p>
						<table>
							<thead>
								<tr>
									<th>Операционная система</th>
									<th>Версия</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Debian</td>
									<td>Debian 12 Bookworm</td>
									<td>основной рекомендуемый вариант</td>
								</tr>
								<tr>
									<td>Ubuntu Server</td>
									<td>Ubuntu Server 22.04 LTS / 24.04 LTS</td>
									<td>альтернативный вариант</td>
								</tr>
							</tbody>
						</table>
						<h3 data-heading="2.3 Требования к системным пакетам" dir="auto">
							2.3 Требования к системным пакетам
						</h3>
						<p dir="auto">
							На сервере должны быть установлены базовые административные и диагностические пакеты:
						</p>
						<table>
							<thead>
								<tr>
									<th>Пакет</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><code>sudo</code></td>
									<td>выполнение административных команд</td>
								</tr>
								<tr>
									<td><code>curl</code></td>
									<td>проверка HTTP/HTTPS-запросов</td>
								</tr>
								<tr>
									<td><code>wget</code></td>
									<td>загрузка файлов</td>
								</tr>
								<tr>
									<td><code>git</code></td>
									<td>работа с репозиториями</td>
								</tr>
								<tr>
									<td><code>nano</code> / <code>vim</code></td>
									<td>редактирование конфигурационных файлов</td>
								</tr>
								<tr>
									<td><code>htop</code></td>
									<td>просмотр нагрузки на сервер</td>
								</tr>
								<tr>
									<td><code>net-tools</code></td>
									<td>сетевые диагностические утилиты</td>
								</tr>
								<tr>
									<td><code>unzip</code>, <code>zip</code></td>
									<td>работа с архивами</td>
								</tr>
								<tr>
									<td><code>ca-certificates</code></td>
									<td>работа с HTTPS-сертификатами</td>
								</tr>
								<tr>
									<td><code>gnupg</code></td>
									<td>работа с ключами репозиториев</td>
								</tr>
								<tr>
									<td><code>lsb-release</code></td>
									<td>определение версии дистрибутива</td>
								</tr>
								<tr>
									<td><code>apt-transport-https</code></td>
									<td>работа с HTTPS-репозиториями</td>
								</tr>
								<tr>
									<td><code>software-properties-common</code></td>
									<td>управление дополнительными репозиториями</td>
								</tr>
								<tr>
									<td><code>ufw</code></td>
									<td>базовая настройка firewall</td>
								</tr>
								<tr>
									<td><code>cron</code></td>
									<td>запуск задач по расписанию</td>
								</tr>
							</tbody>
						</table>
						<p dir="auto">
							Команда установки:
						</p>
<pre class="language-bash"><code class="language-bash is-loaded"><span class="token function">sudo</span> <span class="token function">apt</span> update
<span class="token function">sudo</span> <span class="token function">apt</span> <span class="token function">install</span> <span class="token parameter variable">-y</span> <span class="token function">sudo</span> <span class="token function">curl</span> <span class="token function">wget</span> <span class="token function">git</span> <span class="token function">nano</span> <span class="token function">vim</span> <span class="token function">htop</span> net-tools <span class="token function">unzip</span> <span class="token function">zip</span> ca-certificates gnupg lsb-release apt-transport-https software-properties-common ufw <span class="token function">cron</span>
</code></pre>
						<h3 data-heading="2.4 Требования к веб-серверам" dir="auto">2.4 Требования к веб-серверам</h3>
						<p dir="auto">
							В учебной инфраструктуре используются два веб-сервера:
						</p>
						<table>
							<thead>
								<tr>
									<th>Компонент</th>
									<th>Требование</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Nginx</td>
									<td>версия из репозитория Debian/Ubuntu</td>
									<td>внешний reverse proxy, HTTPS, входная точка приложения</td>
								</tr>
								<tr>
									<td>Apache HTTP Server</td>
									<td>Apache 2.4.x</td>
									<td>внутренний backend-сервер приложения</td>
								</tr>
							</tbody>
						</table>
						<h3 data-heading="Требуемые службы" dir="auto">Требуемые службы</h3>
						<table>
							<thead>
								<tr>
									<th>Служба</th>
									<th>systemd unit</th>
									<th align="right">Порт</th>
									<th>Доступность</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Nginx</td>
									<td><code>nginx.service</code></td>
									<td align="right"><code>80/tcp</code>, <code>443/tcp</code></td>
									<td>внешняя сеть</td>
								</tr>
								<tr>
									<td>Apache</td>
									<td><code>apache2.service</code></td>
									<td align="right"><code>127.0.0.1:8080</code></td>
									<td>только локально</td>
								</tr>
								<tr>
									<td>SSH</td>
									<td><code>ssh.service</code></td>
									<td align="right"><code>22/tcp</code></td>
									<td>административный доступ</td>
								</tr>
							</tbody>
						</table>
						<h3 data-heading="Требуемые модули Apache" dir="auto">Требуемые модули Apache</h3>
						<table>
							<thead>
								<tr>
									<th>Модуль</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><code>rewrite</code></td>
									<td>поддержка URL rewriting</td>
								</tr>
								<tr>
									<td><code>proxy</code></td>
									<td>проксирование запросов при необходимости</td>
								</tr>
								<tr>
									<td><code>proxy_fcgi</code></td>
									<td>взаимодействие с PHP-FPM при использовании FastCGI</td>
								</tr>
								<tr>
									<td><code>headers</code></td>
									<td>управление HTTP-заголовками</td>
								</tr>
								<tr>
									<td><code>ssl</code></td>
									<td>поддержка HTTPS при необходимости</td>
								</tr>
							</tbody>
						</table>
						<p dir="auto">
							Команды включения модулей:
						</p>
<pre class="language-bash"><code class="language-bash is-loaded"><span class="token function">sudo</span> a2enmod rewrite
<span class="token function">sudo</span> a2enmod proxy
<span class="token function">sudo</span> a2enmod proxy_fcgi
<span class="token function">sudo</span> a2enmod headers
<span class="token function">sudo</span> a2enmod ssl
</code></pre>
						<h3 data-heading="2.5 Требования к PHP" dir="auto">2.5 Требования к PHP</h3>
						<table>
							<thead>
								<tr>
									<th>Компонент</th>
									<th>Требование</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>PHP</td>
									<td>PHP 8.2 или выше</td>
								</tr>
								<tr>
									<td>Рекомендуемая версия</td>
									<td>PHP 8.2 / 8.3 / 8.4</td>
								</tr>
								<tr>
									<td>Режим работы</td>
									<td>PHP-FPM или модуль Apache</td>
								</tr>
								<tr>
									<td>CLI-интерфейс</td>
									<td>обязателен</td>
								</tr>
								<tr>
									<td>Redis-модуль</td>
									<td>обязателен</td>
								</tr>
							</tbody>
						</table>
						<h3 data-heading="Требуемые PHP-пакеты" dir="auto">Требуемые PHP-пакеты</h3>
						<table>
							<thead>
								<tr>
									<th>Пакет</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><code>php</code></td>
									<td>базовый пакет PHP</td>
								</tr>
								<tr>
									<td><code>php-cli</code></td>
									<td>выполнение PHP из командной строки</td>
								</tr>
								<tr>
									<td><code>php-fpm</code></td>
									<td>обработка PHP через FastCGI Process Manager</td>
								</tr>
								<tr>
									<td><code>php-curl</code></td>
									<td>HTTP-запросы из PHP</td>
								</tr>
								<tr>
									<td><code>php-mbstring</code></td>
									<td>работа с многобайтовыми строками</td>
								</tr>
								<tr>
									<td><code>php-xml</code></td>
									<td>обработка XML</td>
								</tr>
								<tr>
									<td><code>php-zip</code></td>
									<td>работа с ZIP-архивами</td>
								</tr>
								<tr>
									<td><code>php-redis</code></td>
									<td>подключение PHP к Redis</td>
								</tr>
							</tbody>
						</table>
						<p dir="auto">
							Команда установки:
						</p>
<pre class="language-bash"><code class="language-bash is-loaded"><span class="token function">sudo</span> <span class="token function">apt</span> <span class="token function">install</span> <span class="token parameter variable">-y</span> php php-cli php-fpm php-curl php-mbstring php-xml php-zip php-redis
</code></pre>
						<h3 data-heading="2.6 Требования к Redis" dir="auto">2.6 Требования к Redis</h3>
						<table>
							<thead>
								<tr>
									<th>Компонент</th>
									<th>Требование</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Redis</td>
									<td>Redis Open Source 7.x или версия из репозитория Debian/Ubuntu</td>
								</tr>
								<tr>
									<td>Служба</td>
									<td><code>redis-server.service</code></td>
								</tr>
								<tr>
									<td>Порт</td>
									<td><code>6379/tcp</code></td>
								</tr>
								<tr>
									<td>Режим доступа</td>
									<td>только локально</td>
								</tr>
								<tr>
									<td>Адрес привязки</td>
									<td><code>127.0.0.1 ::1</code></td>
								</tr>
