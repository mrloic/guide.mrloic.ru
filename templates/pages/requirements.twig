								</tr>
							</tbody>
						</table>
						<h3 data-heading="Требуемые Redis-пакеты" dir="auto">Требуемые Redis-пакеты</h3>
						<table>
							<thead>
								<tr>
									<th>Пакет</th>
									<th>Назначение</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><code>redis-server</code></td>
									<td>сервер Redis</td>
								</tr>
								<tr>
									<td><code>redis-tools</code></td>
