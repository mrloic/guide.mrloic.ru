{% extends 'layouts/base.twig' %}

{% set page_title = 'Обзор серверного оборудования' %}
{% set body_class = 'subpage' %}
{% block head %}
	<style>
		.hardware-page { max-width: 980px; margin: 0 auto; }

		.hardware-grid { display: grid; gap: 24px; margin-top: 24px; }

		.hardware-card { display: grid; grid-template-columns: 260px 1fr; gap: 22px; align-items: start; padding: 18px;
		background: #ffffff; border: 1px solid #dddddd; border-radius: 8px; }

		.hardware-image { width: 100%; max-width: 260px; height: 180px; object-fit: contain; background: #ffffff;
		border: 1px solid #e0e0e0; border-radius: 6px; }

		.hardware-content h3 { margin-top: 0; margin-bottom: 8px; }

		.hardware-role { margin: 0 0 14px 0; font-weight: 600; color: #444444; }

		.hardware-card table { width: 100%; margin: 0; border-collapse: collapse; }

		.hardware-card th { width: 180px; text-align: left; font-weight: 600; background: #f0f0f0; }

		.hardware-card th, .hardware-card td { padding: 8px 10px; border: 1px solid #dddddd; ertical-align: top; }

		@media screen and (max-width: 768px) { .hardware-card { grid-template-columns: 1fr; }

		.hardware-image { max-width: 100%; height: 220px; }

		.hardware-card th { width: auto; } } .hardware-image { cursor: zoom-in; }

		.image-lightbox { width: 80vw; max-width: 80vw; max-height: 80vh; padding: 0; border: none; border-radius: 10px;
		background: transparent; overflow: visible; }

		.image-lightbox::backdrop { background: rgba(0, 0, 0, 0.78); }

		.image-lightbox__img { display: block; max-width: 80vw; max-height: 80vh; width: auto; height: auto; margin: 0
		auto; object-fit: contain; border-radius: 8px; background: #ffffff; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
		}

		.image-lightbox__close { position: fixed; top: 24px; right: 24px;

		width: 46px; height: 46px;

		border: none; border-radius: 50%;

		background: #ffffff; color: #111111;

		font-size: 32px; line-height: 46px; text-align: center;

		cursor: pointer; z-index: 100000;

		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35); }

		.image-lightbox__close:hover { background: #eeeeee; }

		@media screen and (max-width: 768px) { .image-lightbox__close { top: 14px; right: 14px;

		width: 42px; height: 42px;

		font-size: 30px; line-height: 42px; }

		.image-lightbox__img { max-width: 94vw; max-height: 86vh; } }
	</style>
{% endblock %}
