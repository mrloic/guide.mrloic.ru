{% block javascripts %}
	<script>
		document.addEventListener('DOMContentLoaded', function () { const lightbox =
		document.getElementById('imageLightbox'); const lightboxImg = document.getElementById('imageLightboxImg'); const
		closeBtn = document.querySelector('.image-lightbox__close'); const images =
		document.querySelectorAll('.js-lightbox-image');

		if (!lightbox || !lightboxImg || !closeBtn || images.length === 0) { return; }

		images.forEach(function (image) { image.addEventListener('click', function () { const fullImageSrc =
		image.dataset.full || image.src; const imageAlt = image.alt || 'Изображение оборудования';

		lightboxImg.src = fullImageSrc; lightboxImg.alt = imageAlt;

		if (typeof lightbox.showModal === 'function') { lightbox.showModal(); } else { lightbox.setAttribute('open',
		'open'); } }); });

		function closeLightbox() { if (lightbox.open) { lightbox.close(); }

		lightboxImg.src = ''; lightboxImg.alt = ''; }

		closeBtn.addEventListener('click', closeLightbox);

		lightbox.addEventListener('click', function (event) { if (event.target === lightbox) { closeLightbox(); } });

		document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && lightbox.open) {
		closeLightbox(); } }); });
	</script>
{% endblock %}
